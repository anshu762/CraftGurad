generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLIC_VISITOR
  BUYER
  ARTISAN
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  AVAILABLE
  OFFER_PENDING
  OFFER_ACCEPTED
  RESERVED
  SOLD
  ARCHIVED
}

enum OfferStatus {
  PENDING
  VIEWED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  COMPLETED
}

enum CraftType {
  KASUTI
  ILKAL
}

enum ConsentType {
  PORTRAIT
  QUOTE
  NAME
  LOCATION
  PRODUCT_ATTRIBUTION
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String
  role           Role             @default(BUYER)
  name           String?
  phone          String?
  isActive       Boolean          @default(true)
  artisanProfile ArtisanProfile?
  auditLogs      AuditLog[]
  offerEvents    OfferEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ArtisanProfile {
  id                String          @id @default(cuid())
  user              User            @relation(fields: [userId], references: [id])
  userId            String          @unique
  publicDisplayName String?
  location          String?
  biography         String?
  craftAssociation  CraftType?
  portraitAssetId   String?
  portraitAsset     MediaAsset?     @relation(fields: [portraitAssetId], references: [id])
  profileVisibility Boolean         @default(false)
  contactVisibility Boolean         @default(false)
  consentStatus     ConsentStatus   @default(PENDING)
  consentDocRef     String?
  quotes            Quote[]
  products          Product[]
  consentRecords    ConsentRecord[]
  featuredInStories Story[]         // FIX: opposite side of Story.featuredArtisan
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Quote {
  id        String         @id @default(cuid())
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id])
  artisanId String
  text      String
  approved  Boolean        @default(false)
  createdAt DateTime       @default(now())
}

model Craft {
  id        String    @id @default(cuid())
  type      CraftType @unique
  title     String
  stories   Story[]
  createdAt DateTime  @default(now())
}

model Story {
  id                String          @id @default(cuid())
  title             String
  slug              String          @unique
  craft             Craft           @relation(fields: [craftId], references: [id])
  craftId           String
  subtitle          String?
  intro             String?
  heroMediaId       String?
  heroMedia         MediaAsset?     @relation(fields: [heroMediaId], references: [id])
  sections          StorySection[]
  featuredArtisanId String?
  featuredArtisan   ArtisanProfile? @relation(fields: [featuredArtisanId], references: [id])
  seoTitle          String?
  seoDescription    String?
  published         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model StorySection {
  id               String      @id @default(cuid())
  story            Story       @relation(fields: [storyId], references: [id])
  storyId          String
  sectionNumber    Int
  label            String
  heading          String
  body             String?
  primaryMediaId   String?
  primaryMedia     MediaAsset? @relation("PrimaryMedia", fields: [primaryMediaId], references: [id])
  secondaryMediaId String?
  secondaryMedia   MediaAsset? @relation("SecondaryMedia", fields: [secondaryMediaId], references: [id])
  caption          String?
  quote            String?
  audioUrl         String?
  displayOrder     Int         @default(0)
  published        Boolean     @default(true)
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  craft            CraftType
  description      String?
  story            String?
  material         String?
  technique        String?
  motif            String?
  dimensions       String?
  colour           String?
  makingTimeApprox String?
  artisanId        String?
  artisan          ArtisanProfile? @relation(fields: [artisanId], references: [id])
  makerVisible     Boolean         @default(false)
  origin           String?
  price            Decimal         @db.Decimal(10, 2)
  reservePrice     Decimal?        @db.Decimal(10, 2)
  currency         String          @default("INR")
  status           ProductStatus   @default(DRAFT)
  featured         Boolean         @default(false)
  provenance       String?
  shippingInfo     String?
  published        Boolean         @default(false)
  images           ProductImage[]
  offers           Offer[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([craft, status])
  @@index([featured])
}

model ProductImage {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  mediaAssetId String
  altText      String
  displayOrder Int        @default(0)
}

model MediaAsset {
  id                 String           @id @default(cuid())
  originalFilename   String
  storageKey         String
  mimeType           String
  width              Int?
  height             Int?
  fileSize           Int?
  altText            String?
  caption            String?
  photographerCredit String?
  usageRights        String?
  consentRequired    Boolean          @default(false)
  focalPointX        Float?
  focalPointY        Float?
  uploadStatus       String           @default("PENDING")
  productImages      ProductImage[]
  storiesAsHero      Story[]
  primarySections    StorySection[]   @relation("PrimaryMedia")
  secondarySections  StorySection[]   @relation("SecondaryMedia")
  artisanPortraits   ArtisanProfile[]
  consentRecords     ConsentRecord[]
  createdAt          DateTime         @default(now())
}

model ConsentRecord {
  id           String         @id @default(cuid())
  artisan      ArtisanProfile @relation(fields: [artisanId], references: [id])
  artisanId    String
  mediaAsset   MediaAsset?    @relation(fields: [mediaAssetId], references: [id])
  mediaAssetId String?
  consentType  ConsentType
  status       ConsentStatus  @default(PENDING)
  consentDate  DateTime?
  obtainedBy   String?
  restrictions String?
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
}

model Offer {
  id               String       @id @default(cuid())
  product          Product      @relation(fields: [productId], references: [id])
  productId        String
  buyerName        String
  buyerEmail       String
  buyerPhone       String
  message          String?
  preferredContact String?
  shippingLocation String?
  originalAmount   Decimal      @db.Decimal(10, 2)
  currentAmount    Decimal      @db.Decimal(10, 2)
  status           OfferStatus  @default(PENDING)
  consentGiven     Boolean      @default(false)
  termsAccepted    Boolean      @default(false)
  expiresAt        DateTime?
  events           OfferEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId, status])
  @@index([createdAt])
}

model OfferEvent {
  id           String      @id @default(cuid())
  offer        Offer       @relation(fields: [offerId], references: [id])
  offerId      String
  status       OfferStatus
  amount       Decimal?    @db.Decimal(10, 2)
  reason       String?
  actionedBy   User?       @relation(fields: [actionedById], references: [id])
  actionedById String?
  ipMeta       String?
  createdAt    DateTime    @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  recipient String
  payload   Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}