DATABASE_URL="postgresql://postgres:password@localhost:5432/craftguard?schema=public"
JWT_SECRET="craftguard-super-secret-key-change-in-production-2024"
JWT_REFRESH_SECRET="craftguard-refresh-secret-key-change-in-production-2024"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@craftguard.com"

# Media Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100